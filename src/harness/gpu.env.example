# Copy to src/harness/gpu.env (ignored by git) and fill in; read by src/harness/gpu_service.py.
# Variables already set in the environment win; every entry is passed to the GPU workers.
# Relative paths are resolved against the repository root.

# Python of the SAM 3 environment
R2S_SAM3_PYTHON=~/miniconda3/envs/sam3/bin/python
# sam3.pt; leave unset to use the local Hugging Face cache of facebook/sam3
# R2S_SAM3_CHECKPOINT=checkpoints/sam3/sam3.pt

# Python of the Pi3 environment and the Pi3X weights
R2S_PI3X_PYTHON=~/miniconda3/envs/pi3/bin/python
R2S_PI3X_CHECKPOINT=checkpoints/Pi3X/model.safetensors

# Optional
# R2S_PI3X_REPO=third_party/Pi3    # the Pi3 checkout (this is the default)
# CUDA_HOME=/usr/local/cuda-12.4
# HF_HOME=~/.cache/huggingface
# R2S_PI3X_WINDOW_FRAMES=64     # Pi3X frames per forward pass (halved automatically on out-of-memory)
# R2S_GPU_DEBUG=1               # worker tracebacks in the result's stderr_tail
